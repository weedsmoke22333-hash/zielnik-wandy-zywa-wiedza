# ── Public (exposed to the browser — no secrets here) ─────────────────────────
VITE_SITE_URL=https://twojadomena.pl          # canonical URLs, Open Graph
VITE_CONTACT_EMAIL=kontakt@twojadomena.pl      # shown on /kontakt
VITE_PLAUSIBLE_DOMAIN=                         # e.g. twojadomena.pl — cookieless analytics; empty = off

# ── Server-only secrets (never prefix with VITE_) ─────────────────────────────
PUBLIC_SITE_URL=https://twojadomena.pl         # used in Stripe redirect URLs, e-mails, sitemap

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=                             # public by design; used only by the /admin login
SUPABASE_SERVICE_ROLE_KEY=                     # SECRET — bypasses RLS, server routes only

# Stripe (Developers → API keys / Webhooks). Start with test keys (sk_test_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                         # whsec_… for endpoint /api/stripe-webhook
PAYMENTS_ENABLED=false                         # flip to true only when legal pages + seller data are complete

# Newsletter + lead magnet (MailerLite → Integrations → API)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=                           # group with double opt-in + automation that sends the PDF

# Transactional e-mail (Resend) — contact form + download links after purchase
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=                            # verified sender, e.g. "Wanda Machocka <sklep@twojadomena.pl>"
